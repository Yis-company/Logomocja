{
  "name": "logomocja",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "sh scripts/install-hooks.sh",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages && mkdir -p builds && cp -R builds dist/",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:e2e": "bun run build && playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "bench": "bash bench/bench.sh",
    "bench:queue": "bash bench/queue.sh",
    "bench:status": "bun bench/queue.ts status",
    "bench:conformance": "bun bench/conformance/run.ts",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && bun install --lockfile-only"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.0"
  }
}
