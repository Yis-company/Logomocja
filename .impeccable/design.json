  "components": [
    {
      "name": "Run Button",
      "kind": "button",
      "refersTo": "button-run",
      "description": "Primary action: runs the program from the start in the current mode's ink.",
      "html": "<button class=\"ds-btn-run\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 3l14 9-14 9z\"/></svg>Uruchom</button>",
      "css": ":host{--ink:#15211d;--sheet:#fbfcfa;--sheet-2:#f5f7f3;--rule-strong:#aeb9b2;--band:#137a60;--on-band:#fff;--focus:#1f5d9e;font-family:'Archivo Variable',Archivo,system-ui,sans-serif}.ds-btn-run{display:inline-flex;align-items:center;gap:6px;height:36px;padding:0 16px;border:1px solid transparent;border-radius:5px;background:#137a60;color:#fff;font:650 13px 'Archivo Variable',Archivo,sans-serif;cursor:pointer;transition:background-color 140ms cubic-bezier(.16,1,.3,1)}.ds-btn-run:hover{background:color-mix(in oklab,#137a60 84%,#000)}.ds-btn-run:active{background:color-mix(in oklab,#137a60 72%,#000)}.ds-btn-run:focus-visible{outline:2px solid #1f5d9e;outline-offset:2px}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Step, Pause/Resume, Reset and the file menu.",
      "html": "<button class=\"ds-btn-quiet\">Krok</button>",
      "css": ".ds-btn-quiet{display:inline-flex;align-items:center;gap:6px;height:36px;padding:0 12px;border:1px solid #aeb9b2;border-radius:5px;background:#fbfcfa;color:#15211d;font:650 13px 'Archivo Variable',Archivo,sans-serif;cursor:pointer;transition:background-color 140ms,border-color 140ms}.ds-btn-quiet:hover{background:#f5f7f3;border-color:#5c6a65}.ds-btn-quiet:focus-visible{outline:2px solid #1f5d9e;outline-offset:2px}.ds-btn-quiet:disabled{opacity:.42;cursor:not-allowed}"
    },
    {
      "name": "Mode Switch",
      "kind": "custom",
      "refersTo": "segmented-mode-on",
      "description": "2D/3D segmented switch; the pressed side fills with its own ink.",
      "html": "<div class=\"ds-seg\" role=\"group\" aria-label=\"Tryb rysowania\"><button aria-pressed=\"true\">2D</button><button aria-pressed=\"false\">3D</button></div>",
      "css": ".ds-seg{display:inline-flex;padding:2px;border:1px solid #aeb9b2;border-radius:7px;background:#f5f7f3}.ds-seg button{min-width:56px;height:30px;border:0;border-radius:5px;background:transparent;color:#44524d;font:750 13px 'Archivo Variable',Archivo,sans-serif;letter-spacing:.04em;cursor:pointer}.ds-seg button:hover{background:#d3dad4;color:#15211d}.ds-seg button[aria-pressed=true]:first-child{background:#137a60;color:#fff}.ds-seg button[aria-pressed=true]:last-child{background:#2b68a8;color:#fff}.ds-seg button:focus-visible{outline:2px solid #1f5d9e;outline-offset:2px}"
    },
    {
      "name": "Chart Band",
      "kind": "custom",
      "refersTo": "chart-band",
      "description": "Signature: the wall chart's ink title band with the program name in condensed caps and the mode chip.",
      "html": "<div class=\"ds-band\"><h2>Drzewo</h2><span>2D</span></div>",
      "css": ".ds-band{display:flex;align-items:center;gap:12px;height:56px;padding:0 24px;background:#137a60;color:#fff}.ds-band h2{margin:0;font:780 28px/1 'Archivo Variable',Archivo,sans-serif;font-stretch:68%;text-transform:uppercase;letter-spacing:.02em}.ds-band span{padding:3px 7px 2px;border:1.5px solid #fff;border-radius:3px;font:800 12px 'Archivo Variable',Archivo,sans-serif;letter-spacing:.08em}"
    },
    {
      "name": "Key Band",
      "kind": "custom",
      "refersTo": "key-band",
      "description": "Signature: numbered ink key under a 2px ink rule, with the live turtle readout.",
      "html": "<div class=\"ds-key\"><span class=\"n\">1</span><span class=\"sw\" style=\"background:#6b4f2a\"></span><span><code>#6b4f2a</code> 15 odcinków, długość 639</span><span class=\"ro\">x 0 · y −120 · kierunek 0°</span></div>",
      "css": ".ds-key{display:flex;align-items:center;gap:8px;min-height:44px;padding:9px 24px;border-top:2px solid #15211d;background:#fbfcfa;color:#15211d;font:400 12px 'Archivo Variable',Archivo,sans-serif}.ds-key .n{display:inline-grid;place-items:center;width:21px;height:21px;border:1.5px solid #15211d;border-radius:50%;font-weight:800;font-size:11px}.ds-key .sw{width:22px;height:10px;border-radius:2px}.ds-key code{font:11.5px 'JetBrains Mono Variable',ui-monospace,monospace;color:#44524d}.ds-key .ro{margin-left:auto;font:12px 'JetBrains Mono Variable',ui-monospace,monospace;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "app-header",
      "description": "Header-ink bar; the current page is underlined in its section's ink.",
      "html": "<nav class=\"ds-nav\"><a aria-current=\"page\" href=\"#\">Pracownia</a><a href=\"#\">Przykłady</a><a href=\"#\">Zadania</a><a href=\"#\">Pomoc</a></nav>",
      "css": ".ds-nav{display:flex;height:52px;background:#14302a}.ds-nav a{display:flex;align-items:center;padding:3px 14px 0;border-bottom:3px solid transparent;color:#b5c8bf;font:600 13px 'Archivo Variable',Archivo,sans-serif;text-decoration:none}.ds-nav a:hover{color:#eef3ef}.ds-nav a[aria-current=page]{color:#eef3ef;border-bottom-color:#4cc59c}.ds-nav a:focus-visible{outline:2px solid #fff;outline-offset:-4px}"
    },
    {
      "name": "Mode Tag",
      "kind": "chip",
      "refersTo": "tag-2d",
      "description": "Mode tag on cells: the mode's band ink with white caps.",
      "html": "<span class=\"ds-tag\">2D</span> <span class=\"ds-tag ds-tag-3d\">3D</span>",
      "css": ".ds-tag{display:inline-block;padding:2px 6px 1px;border-radius:3px;background:#137a60;color:#fff;font:800 11.5px/1.35 'Archivo Variable',Archivo,sans-serif;letter-spacing:.06em}.ds-tag-3d{background:#2b68a8}"
    },
    {
      "name": "Example Cell",
      "kind": "card",
      "refersTo": "cell",
      "description": "Gallery/challenge cell: the program's own drawing as the thumbnail.",
      "html": "<a class=\"ds-cell\" href=\"#\"><div class=\"fig\"><svg viewBox=\"0 0 100 70\" width=\"100%\"><rect x=\"32\" y=\"8\" width=\"36\" height=\"54\" fill=\"none\" stroke=\"#16866a\" stroke-width=\"2\"/></svg></div><div class=\"b\"><strong>Kwadrat</strong><p>Cztery kroki do pierwszego rysunku.</p></div></a>",
      "css": ".ds-cell{display:flex;flex-direction:column;width:232px;background:#fbfcfa;border:1px solid #d3dad4;border-radius:4px;color:#15211d;text-decoration:none;transition:border-color 140ms,box-shadow 140ms;font-family:'Archivo Variable',Archivo,sans-serif}.ds-cell:hover{border-color:#5c6a65;box-shadow:0 4px 14px -6px rgb(20 48 42/.25)}.ds-cell:focus-visible{outline:2px solid #1f5d9e;outline-offset:2px}.ds-cell .fig{background:#fcfdfb;border-bottom:1px solid #d3dad4}.ds-cell .b{padding:12px 14px 14px}.ds-cell p{margin:4px 0 0;color:#44524d;font-size:13px}"
    },
    {
      "name": "Error Bubble",
      "kind": "custom",
      "refersTo": "error-bubble",
      "description": "Inline Polish error message under the offending column.",
      "html": "<div class=\"ds-err\">Nieoczekiwana wartość „-5” — w tym miejscu powinno stać polecenie.</div>",
      "css": ".ds-err{position:relative;max-width:46ch;padding:6px 10px 7px;border-radius:6px;background:#b9341b;color:#fff;font:13px/1.35 'Archivo Variable',Archivo,sans-serif;box-shadow:0 8px 24px -6px rgb(20 48 42/.28),0 2px 6px rgb(20 48 42/.12)}.ds-err::before{content:'';position:absolute;left:10px;top:-5px;border:5px solid transparent;border-top:0;border-bottom-color:#b9341b}"
    }
  ],
  "narrative": {
    "northStar": "The Classroom Wall Chart",
    "overview": "Logomocja looks like the printed teaching charts (plansze dydaktyczne) that hung in Polish classrooms. The drawing area is the chart. It has a solid ink title band with the program's name in condensed capitals, a figure on gridded paper, and a key band that numbers each ink and says how much it drew. Everything else is a working editor and the controls people already know (buttons, a segmented switch, a slider, a disclosure menu), with no costume. The world contributes four things: type, palette, density and one signature move (the numbered callouts).\n\nColour is a set of flat spot inks taken from the language's own colours, and each ink belongs to one part of the app: chart green for 2D, ultramarine for 3D, ochre for challenges and trunk brown for the reference. The ground is cool, slightly green chart paper, never cream. The dark theme is the classroom blackboard, a green-black slate with the same inks lightened. Vermilion is used for errors only.",
