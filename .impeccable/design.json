  "narrative": {
    "northStar": "Pracownia odkrywców",
    "overview": "System przywołuje muzealną pracownię edukacyjną: spokojne otoczenie, czytelne opisy i wolną przestrzeń do eksperymentowania. Zieleń wiąże działania z rysunkiem. Geometria jest prawdziwym rezultatem programu, a interfejs pomaga ją obejrzeć i zrozumieć.\n\nTo powierzchnia Operate. Znane przyciski, pola i nawigacja mają pierwszeństwo przed ozdobą. Charakter powstaje przez szałwiowe tło, precyzyjne wyrównanie, lokalne fonty i miniatury wykonywanych programów.",
    "keyCharacteristics": [
      "Jasne i ciemne powierzchnie o zielonym tonie.",
      "Płaskie podziały i oszczędna hierarchia tekstu.",
      "Autentyczne rysunki żółwia zamiast dekoracyjnych ilustracji.",
      "Jawne stany wykonania, błędów i lokalnego zapisu."
    ],
    "rules": [
      {
        "name": "The Action Green Rule",
        "body": "Akcent wskazuje działanie, wybór lub stan; kolory samego rysunku należą do programu użytkownika.",
        "section": "colors"
      },
      {
        "name": "The Code Is Code Rule",
        "body": "Monospace służy kodowi i pomiarom, nie etykietom interfejsu.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Głębię w stałym układzie tworzą odcienie i podziały; warstwa nad nim może użyć miękkiego cienia.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** pozostawiaj rysunkowi dużą, spokojną powierzchnię.",
      "**Do** zachowuj wspólne wyrównania paneli i kontrolki przy ich zadaniu.",
      "**Do** pokazuj stan słowem oraz znakiem, także w motywie ciemnym.",
      "**Do** używaj prawdziwego interpretera do podglądów programów."
    ],
    "donts": [
      "**Don't** dodawaj dekoracyjnych kart i cieni do stałego układu pracy.",
      "**Don't** zastępuj geometrii ilustracją lub statyczną atrapą wyniku.",
      "**Don't** używaj monospace jako ozdoby etykiet.",
      "**Don't** polegaj wyłącznie na kolorze przy błędach i ukończeniu zadań."
    ]
  }
