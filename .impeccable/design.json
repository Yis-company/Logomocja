  "narrative": {
    "northStar": "The geometry workbench",
    "overview": "A working studio that puts the learner's source and its geometric consequence together. Clear type, measured spacing and ordinary controls make the interface familiar; the turtle's actual drawing gives it character. Nostalgia appears in the language and the little turtle mark, rather than simulated retro chrome.\n\nThe shell is quiet and warm, with a forest teal used for action, selection and execution. A dark green neutral palette follows system preference or the learner's manual choice. Both themes keep the same layout and semantic roles.",
    "keyCharacteristics": [
      "Live geometry leads; controls support it.",
      "Flat surfaces with fine shared dividers.",
      "Local sans typography, with monospace reserved for code and coordinates.",
      "Teal action and selection; explicit Polish error recovery."
    ],
    "rules": [
      {
        "name": "The Exact Ink Rule",
        "body": "Theme changes may restyle the studio, but must preserve program stroke colors.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use sans for the interface and prose; use monospace for code, keyboard keys and numerical measurement.",
        "section": "typography"
      },
      {
        "name": "The Flat Work Rule",
        "body": "Reserve elevation for temporary layers that cover the task.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do show the actual interpreter output in every example thumbnail.",
      "Do preserve the same source-line metrics across the editor layers.",
      "Do keep actions, selections and errors semantically consistent across themes.",
      "Do expose icon-only controls through explicit accessible names."
    ],
    "donts": [
      "Don't recolor a program's drawing to match the theme.",
      "Don't cover the source or drawing with persistent decoration.",
      "Don't use display typography for compact task controls.",
      "Don't add shadows to the flat workbench panes."
    ]
  }
}
