  "narrative": {
    "northStar": "The Two-Colour Textbook",
    "keyCharacteristics": [
      "Spot green owns the header band, primary actions, figure and exercise numbers; nothing else is green but syntax and drawings.",
      "Highlighter yellow means “now”: the executing line and the turtle.",
      "The drawing sheet has a real measuring grid, origin, axes and a scale bar (podziałka).",
      "Hairline rules divide everything; elevation is reserved for overlays."
    ],
    "rules": [
      {
        "name": "The One Spot Rule",
        "section": "colors",
        "body": "The shell is printed in ink plus one spot green. A new UI colour must carry state or data, never decoration."
      },
      {
        "name": "The Highlighter Rule",
        "section": "colors",
        "body": "Yellow marks only what is happening now (the executing line and the turtle). Never brand, emphasis or hover."
      },
      {
        "name": "The Weight-Not-Size Rule",
        "section": "typography",
        "body": "Rank with Lato's 700 and 900 inside a tight 12–30px range; do not add display sizes to working screens."
      },
      {
        "name": "The Registration Rule",
        "section": "layout",
        "body": "Rows that face each other across panes share one height; a new bar takes 52px or 44px, nothing in between."
      },
      {
        "name": "The Print Rule",
        "section": "elevation",
        "body": "Surfaces at rest have no shadow; one border or one shadow, never both on a resting element."
      }
    ],
    "dos": [
      "Do caption every drawing as a numbered figure and number every task like a textbook exercise.",
      "Do keep the shell to ink plus spot green, with state colours only where they mean something.",
      "Do keep facing bars at 52px and footers at 44px across panes.",
      "Do use hairline rules (1px rule) to divide regions and packed whole-cell grids for catalogues."
    ],
    "donts": [
      "Don't use highlighter yellow for anything except the executing line and the turtle.",
      "Don't add shadows to resting surfaces or wrap content in cards.",
      "Don't set UI labels in the mono face; mono is for code, keys and data.",
      "Don't drift toward cream paper or a dark-IDE-with-neon look; both are refused by this world's thesis."
    ]
  }
